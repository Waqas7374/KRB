# =============================================================================
# KRB ERP — environment configuration
# Copy to .env and fill in. The API refuses to start if a required value is
# missing or malformed (see backend/app/core/config.py).
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=KRB ERP
APP_ENV=development                  # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                   # console | json   (use json in production)
API_V1_PREFIX=/api/v1
ROOT_PATH=

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_byte_urlsafe_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# Account lockout
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Argon2id parameters
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# --- CORS --------------------------------------------------------------------
# Comma-separated. No wildcard in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
CORS_ALLOW_CREDENTIALS=true

# --- Database ----------------------------------------------------------------
POSTGRES_USER=krb
POSTGRES_PASSWORD=krb_dev_password
POSTGRES_DB=krb_erp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port the db container publishes on. Change if 5432 is already taken
# on your machine; containers always reach the database at db:5432.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
DATABASE_URL=postgresql+asyncpg://krb:krb_dev_password@localhost:5432/krb_erp
# Sync URL used by Alembic only
DATABASE_URL_SYNC=postgresql+psycopg://krb:krb_dev_password@localhost:5432/krb_erp
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Object storage (S3 protocol: MinIO locally, R2/S3/B2 in production) ------
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=krb-erp
STORAGE_REGION=auto
# The address browsers and phones upload to (signed into every upload/download URL).
# Empty: the compose file uses http://localhost:9000. From an Android emulator use
# http://10.0.2.2:9000; from a real phone, this machine's LAN address.
STORAGE_PUBLIC_BASE_URL=
STORAGE_PRESIGN_TTL_SECONDS=900
MAX_UPLOAD_BYTES=26214400            # 25 MiB
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# --- Email -------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=no-reply@krb-erp.local
MAIL_FROM_NAME=KRB ERP
# Browser-facing origin of the web app; emailed invitation and reset links point here.
WEB_BASE_URL=http://localhost:5173
# Invitation links live longer than reset links (hours).
INVITE_LINK_TTL_HOURS=72

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_15MIN=5
RATE_LIMIT_SYNC_PER_MINUTE=60

# --- Company defaults (Pakistan — see docs/12-confirmed-decisions.md) --------
DEFAULT_COMPANY_CODE=KRB
DEFAULT_CURRENCY=PKR
DEFAULT_TIMEZONE=Asia/Karachi
DEFAULT_LOCALE=en-PK
FISCAL_YEAR_START_MONTH=7            # 1 July

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
METRICS_ENABLED=true

# --- Frontend (web/.env) -----------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=KRB ERP
VITE_SENTRY_DSN=
